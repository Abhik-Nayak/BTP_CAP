{
  "name": "cap-agent",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@cap-js/agents": "^0.9.8",
    "@sap/cds": "^10"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3"
  },
  "scripts": {
    "start": "cds-serve"
  },
  "private": true,
  "cds": {
    "requires": {
      "llm": {
        "kind": "openai",
        "model": "qwen3:4b-instruct",
        "credentials": {
          "baseURL": "http://localhost:11434/v1",
          "apiKey": "ollama"
        }
      },
      "llm-smart": {
        "kind": "openai",
        "model": "qwen3:8b",
        "credentials": {
          "baseURL": "http://localhost:11434/v1",
          "apiKey": "ollama"
        }
      },
      "[smart]": {
        "llm": {
          "model": "qwen3:8b"
        }
      },
      "[mock]": {
        "llm": "mock"
      }
    },
    "mcp": {
      "per_action_tool": true
    }
  }
}
